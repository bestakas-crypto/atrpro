# ATRsite-pro 환경변수 예시 -- 실제 값은 .env에만 넣고 절대 git에 커밋하지 말 것
# (스펙 14.2). 이 파일은 항목명만 보여주는 템플릿이다.

# 스펙 4.10 -- 동일 코드베이스를 이름만 바꿔 ATRsite/Jina로 각각 배포할 때 사용.
APP_NAME=ATRsite
APP_SHORT_NAME=ATR

# 스펙 14.1 -- 단일 사용자 인증. 비워두면(로컬 개발) 인증을 강제하지 않는다.
# 배포 환경에서는 반드시 채울 것 (프런트엔드는 fetch에 X-API-Key 헤더로 실어 보낸다).
API_KEY=

# 한국투자증권(KIS) Open API -- adapters/kis_client.py
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
# true/false -- true면 모의투자(virtual) 서버, false면 실전(live) 서버로 접속한다.
KIS_IS_PAPER_TRADING=true

# 텔레그램 알림 -- adapters/telegram_client.py
# 비워두면 콘솔 로그만 출력하는 더미 모드로 동작한다 (프롬프트 4단계 지시).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM 매크로 브리핑 -- adapters/llm_client.py (2026-08-03 추가)
# 넷 다 비어있으면 더미 모드로 동작. ANTHROPIC_API_KEY 하나만 채워도 충분
# (1단계 객관조회는 Gemini 우선, 2단계 판단은 Claude 우선 -- 자세한 단계별
# 폴백 순서는 llm_client.py의 _FALLBACK_CHAINS 참고). C:\mmean과는 완전히
# 별개로 관리(같은 키를 재사용할지 새로 발급할지는 아직 결정 안 됨).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# DeepSeek -- 2단계(판단) 저렴한 폴백 후보. 자체 웹서치가 없어서 1단계
# (실시간 조회)에는 안 쓴다.
DEEPSEEK_API_KEY=

# 선택 -- 기본값은 backend/atrsite/config.py 참고. 배포 환경에서 경로를
# 바꾸고 싶을 때만 채운다.
# ATRSITE_DB_PATH=/opt/atrsite/data/atrsite.db
# ATRSITE_FRONTEND_DIR=/opt/atrsite/frontend
# ATRSITE_BACKUPS_DIR=/opt/atrsite/backups
