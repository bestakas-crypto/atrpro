[Unit]
Description=ATRsite-pro market data worker (시세 폴링 + ATR + 신호 + 알림 Outbox)
After=network.target atrsite-web.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=atrsite
Group=atrsite
WorkingDirectory=/opt/atrsite
Environment=PYTHONPATH=/opt/atrsite/backend
EnvironmentFile=/opt/atrsite/.env
ExecStart=/opt/atrsite/venv/bin/python -m atrsite.worker
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/atrsite/data /opt/atrsite/backups

[Install]
WantedBy=multi-user.target
