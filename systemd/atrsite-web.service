[Unit]
Description=ATRsite-pro web (FastAPI, uvicorn)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=atrsite
Group=atrsite
WorkingDirectory=/opt/atrsite
EnvironmentFile=/opt/atrsite/.env
ExecStart=/opt/atrsite/venv/bin/uvicorn atrsite.main:app --app-dir backend --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=10

# 최소 권한 -- 필요한 경로 외에는 쓰기 접근을 막는다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/atrsite/data /opt/atrsite/backups

[Install]
WantedBy=multi-user.target
